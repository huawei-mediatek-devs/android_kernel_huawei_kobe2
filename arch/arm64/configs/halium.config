CONFIG_NAMESPACES=y
CONFIG_SYSVIPC=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
